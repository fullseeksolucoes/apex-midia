generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  client          String
  year            Int
  category        ProjectCategory
  excerpt         String
  brief           String
  featured        Boolean         @default(false)
  order           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  featuredOnAbout Boolean         @default(false)
  credits         ProjectCredit[]
  media           ProjectMedia[]

  @@index([category])
  @@index([featured])
  @@index([featuredOnAbout])
}

model ProjectMedia {
  id        String       @id @default(cuid())
  projectId String
  slot      MediaSlot
  type      MediaType
  src       String
  poster    String?
  caption   String?
  width     Int
  height    Int
  aspect    MediaAspect?
  order     Int          @default(0)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectCredit {
  id        String  @id @default(cuid())
  projectId String
  role      String
  name      String
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  logo      String
  width     Int
  height    Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id          String             @id @default(cuid())
  name        String
  email       String
  company     String?
  projectType ContactProjectType
  message     String
  status      ContactStatus      @default(NEW)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  msclkid     String?
  ttclid      String?
  referrer    String?
  landingPage String?
  userAgent   String?

  @@index([status, createdAt])
  @@index([utmCampaign])
}

model ReceivedEmail {
  id        String   @id @default(cuid())
  emailId   String   @unique
  from      String
  to        String[]
  cc        String[]
  bcc       String[]
  subject   String?
  textBody  String?
  htmlBody  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AboutGallery {
  id                String              @id
  layout            AboutGalleryLayout  @default(STAGGERED)
  visibleCount      Int                 @default(6)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  AboutGalleryImage AboutGalleryImage[]
}

model AboutGalleryImage {
  id           String       @id
  galleryId    String
  src          String
  width        Int
  height       Int
  caption      String?
  visible      Boolean      @default(true)
  order        Int          @default(0)
  AboutGallery AboutGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
}

enum ProjectCategory {
  BRAND
  FASHION
  MUSIC
  CAR
  EVENT
  INSTITUTIONAL
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaAspect {
  WIDE
  TALL
  SQUARE
}

enum MediaSlot {
  COVER
  HERO
  GALLERY
}

enum ContactProjectType {
  BRAND
  COMMERCIAL
  FASHION
  MUSIC
  DOCUMENTARY
  OTHER
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  ARCHIVED
}

enum AboutGalleryLayout {
  STAGGERED
  MOSAIC
  DUO
  FILMSTRIP
}

enum AboutGalleryLayout {
  STAGGERED
  MOSAIC
  DUO
  FILMSTRIP
}

model AboutGallery {
  id           String             @id @default(cuid())
  layout       AboutGalleryLayout @default(STAGGERED)
  visibleCount Int                @default(6)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  images AboutGalleryImage[]
}

model AboutGalleryImage {
  id        String       @id @default(cuid())
  galleryId String
  gallery   AboutGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  src       String
  width     Int
  height    Int
  caption   String?
  visible   Boolean      @default(true)
  order     Int          @default(0)

  @@index([galleryId])
}
